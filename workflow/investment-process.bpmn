<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="InvestmentProcess" name="Investment Request Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Receive Request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:parallelGateway id="Gateway_ParallelStart">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:serviceTask id="Task_VerifyNationalId" name="Verify National ID (API)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_VerifyTax" name="Verify Tax Clearance (API)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:serviceTask>
    
    <bpmn:parallelGateway id="Gateway_ParallelEnd">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:businessRuleTask id="Task_RiskEvaluation" name="Risk Evaluation (jBPM Rules)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    
    <bpmn:userTask id="Task_OfficialApproval" name="Official Approval Dashboard">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:boundaryEvent id="Event_SlaTimer" name="SLA Timer (48h)" attachedToRef="Task_OfficialApproval">
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Sla">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    
    <bpmn:serviceTask id="Task_EscalateRequest" name="Escalate Request">
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyEscalated</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_NotifyKafkaEscalated" name="Notify Escalation (Kafka)">
      <bpmn:incoming>Flow_ToNotifyEscalated</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEscalatedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Escalated" name="Escalation Logged">
      <bpmn:incoming>Flow_ToEscalatedEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approved?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask id="Task_RegisterCompany" name="Register Company (API)">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_NotifyKafkaApproved" name="Notify Approval (Kafka)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Approved" name="Process Completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:serviceTask id="Task_NotifyKafkaRejected" name="Notify Rejection (Kafka)">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Rejected" name="Process Rejected">
      <bpmn:incoming>Flow_ToRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flows mapping -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_ParallelStart" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_ParallelStart" targetRef="Task_VerifyNationalId" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_ParallelStart" targetRef="Task_VerifyTax" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_VerifyNationalId" targetRef="Gateway_ParallelEnd" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_VerifyTax" targetRef="Gateway_ParallelEnd" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_ParallelEnd" targetRef="Task_RiskEvaluation" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RiskEvaluation" targetRef="Task_OfficialApproval" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_OfficialApproval" targetRef="Gateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_ApprovalDecision" targetRef="Task_RegisterCompany" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_ApprovalDecision" targetRef="Task_NotifyKafkaRejected" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_RegisterCompany" targetRef="Task_NotifyKafkaApproved" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyKafkaApproved" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_ToRejectedEnd" sourceRef="Task_NotifyKafkaRejected" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_Escalate" sourceRef="Event_SlaTimer" targetRef="Task_EscalateRequest" />
    <bpmn:sequenceFlow id="Flow_ToNotifyEscalated" sourceRef="Task_EscalateRequest" targetRef="Task_NotifyKafkaEscalated" />
    <bpmn:sequenceFlow id="Flow_ToEscalatedEnd" sourceRef="Task_NotifyKafkaEscalated" targetRef="EndEvent_Escalated" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="InvestmentProcess">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="295" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_ParallelStart_di" bpmnElement="Gateway_ParallelStart" isMarkerVisible="true">
        <dc:Bounds x="240" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_VerifyNationalId_di" bpmnElement="Task_VerifyNationalId">
        <dc:Bounds x="330" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_VerifyTax_di" bpmnElement="Task_VerifyTax">
        <dc:Bounds x="330" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_ParallelEnd_di" bpmnElement="Gateway_ParallelEnd" isMarkerVisible="true">
        <dc:Bounds x="470" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_RiskEvaluation_di" bpmnElement="Task_RiskEvaluation">
        <dc:Bounds x="560" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_OfficialApproval_di" bpmnElement="Task_OfficialApproval">
        <dc:Bounds x="700" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Event_SlaTimer_di" bpmnElement="Event_SlaTimer">
        <dc:Bounds x="752" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="731" y="335" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_EscalateRequest_di" bpmnElement="Task_EscalateRequest">
        <dc:Bounds x="720" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NotifyKafkaEscalated_di" bpmnElement="Task_NotifyKafkaEscalated">
        <dc:Bounds x="860" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Escalated_di" bpmnElement="EndEvent_Escalated">
        <dc:Bounds x="1002" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="975" y="475" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_ApprovalDecision_di" bpmnElement="Gateway_ApprovalDecision" isMarkerVisible="true">
        <dc:Bounds x="850" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="221" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_RegisterCompany_di" bpmnElement="Task_RegisterCompany">
        <dc:Bounds x="950" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NotifyKafkaApproved_di" bpmnElement="Task_NotifyKafkaApproved">
        <dc:Bounds x="1090" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1232" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1223" y="205" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_NotifyKafkaRejected_di" bpmnElement="Task_NotifyKafkaRejected">
        <dc:Bounds x="950" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1092" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1067" y="345" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="270" />
        <di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="265" y="245" />
        <di:waypoint x="265" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="265" y="295" />
        <di:waypoint x="265" y="360" />
        <di:waypoint x="330" y="360" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="430" y="180" />
        <di:waypoint x="495" y="180" />
        <di:waypoint x="495" y="245" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="430" y="360" />
        <di:waypoint x="495" y="360" />
        <di:waypoint x="495" y="245" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="520" y="270" />
        <di:waypoint x="560" y="270" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="660" y="270" />
        <di:waypoint x="700" y="270" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="800" y="270" />
        <di:waypoint x="850" y="270" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="875" y="245" />
        <di:waypoint x="875" y="180" />
        <di:waypoint x="950" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="881" y="210" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="875" y="295" />
        <di:waypoint x="875" y="320" />
        <di:waypoint x="950" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="300" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1050" y="180" />
        <di:waypoint x="1090" y="180" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1190" y="180" />
        <di:waypoint x="1232" y="180" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToRejectedEnd_di" bpmnElement="Flow_ToRejectedEnd">
        <di:waypoint x="1050" y="320" />
        <di:waypoint x="1092" y="320" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_Escalate_di" bpmnElement="Flow_Escalate">
        <di:waypoint x="770" y="328" />
        <di:waypoint x="770" y="410" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToNotifyEscalated_di" bpmnElement="Flow_ToNotifyEscalated">
        <di:waypoint x="820" y="450" />
        <di:waypoint x="860" y="450" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToEscalatedEnd_di" bpmnElement="Flow_ToEscalatedEnd">
        <di:waypoint x="960" y="450" />
        <di:waypoint x="1002" y="450" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
